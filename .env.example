# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Environment Variables Template
#  Copy to .env and fill in values:  cp .env.example .env
#
#  ⚠️  NEVER commit .env to git!
#  ⚠️  Add .env to .gitignore immediately!
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Docker Compose ────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=myapp
IMAGE_NAME=myrepo/myapp
IMAGE_TAG=latest

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=myapp_db
POSTGRES_USER=myapp_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRY=7d

# ── External Services ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME

S3_BUCKET=my-app-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_grafana_admin_password

# ── SSL ───────────────────────────────────────────────────────────────────────
DOMAIN=myapp.example.com
CERTBOT_EMAIL=admin@example.com
