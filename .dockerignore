# ─────────────────────────────────────────────────────────────────────────────
#  .dockerignore — Global (place at project root)
#  Prevents files from being sent to the Docker build context
#  Smaller context = faster builds + smaller images
# ─────────────────────────────────────────────────────────────────────────────

# ── Version Control ───────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ── CI/CD ─────────────────────────────────────────────────────────────────────
.gitlab-ci.yml
.travis.yml
Jenkinsfile
.circleci

# ── Docker (don't embed Docker files inside images) ───────────────────────────
Dockerfile*
docker-compose*
.dockerignore

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn
.pnpm-store

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__
*.py[cod]
*$py.class
.Python
.venv
venv/
env/
ENV/
*.egg-info/
dist/
build/
.pytest_cache
.mypy_cache
.ruff_cache
*.pyo

# ── Java / Maven / Gradle ─────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
.gradle
build/

# ── Go ────────────────────────────────────────────────────────────────────────
# Go binaries (if build in container, not needed as context)
*.exe
*.exe~

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
build/
out/
*.o
*.a
*.so

# ── Test & Coverage ───────────────────────────────────────────────────────────
coverage/
.coverage
*.lcov
test-results/
.nyc_output
*.test.js
*.spec.js
__tests__/
__mocks__/

# ── Documentation ─────────────────────────────────────────────────────────────
docs/
*.md
!README.md                    # Keep README if needed in image

# ── IDE & Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.editorconfig

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Environment & Secrets (CRITICAL — never in images!) ──────────────────────
.env
.env.*
*.env
.envrc
secrets/
*.pem
*.key
*.cert
*.crt
id_rsa
id_rsa.pub
*.p12
*.pfx

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Temporary files ───────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp

# ── Large media files (if applicable) ────────────────────────────────────────
*.mp4
*.avi
*.mov
*.mkv
*.iso
*.tar.gz        # If not needed in build
*.zip
